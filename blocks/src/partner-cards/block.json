{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "nordic-fund-day/partner-cards",
  "version": "1.0.0",
  "title": "Partner Cards",
  "category": "edge",
  "icon": "awards",
  "description": "Become a Partner section with heading, description, CTA and Gold/Silver partner pricing cards.",
  "textdomain": "nordic-fund-day",
  "attributes": {
    "subtitle": {
      "type": "string",
      "default": "✦ Be in the Spotlight"
    },
    "heading": {
      "type": "string",
      "default": "Become a Partner<br>of Nordic Fund Day"
    },
    "description": {
      "type": "string",
      "default": "Not traditional sponsorship. A chance to position your brand at the centre of conversations, capital and future growth."
    },
    "ctaLabel": {
      "type": "string",
      "default": "Secure Your Partnership Spot"
    },
    "ctaUrl": {
      "type": "string",
      "default": "mailto:torill@nordicedge.org?subject=Secure your partnership spot to Nordic Fund Day Stavanger 2026"
    },
    "ctaOpenInNewTab": {
      "type": "boolean",
      "default": false
    },
    "contactImage": {
      "type": "string",
      "default": ""
    },
    "contactImageId": {
      "type": "number",
      "default": 0
    },
    "contactName": {
      "type": "string",
      "default": "Torill Steinback Hoel"
    },
    "contactTitle": {
      "type": "string",
      "default": "Head of Business Development"
    },
    "contactCompany": {
      "type": "string",
      "default": "Nordic Edge AS"
    },
    "contactEmail": {
      "type": "string",
      "default": "torill@nordicedge.org"
    },
    "contactPhone": {
      "type": "string",
      "default": "+ 47 900 99 349"
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "spacing": { "padding": true, "margin": false }
  },
  "editorScript": "file:./index.js"
}
