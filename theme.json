{
  "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
  "version": 2,

  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1920px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "lime",
          "name": "Lime (Primary Accent)",
          "color": "#D4FF49"
        },
        {
          "slug": "lime-cta",
          "name": "Lime CTA",
          "color": "#CCF546"
        },
        {
          "slug": "black",
          "name": "Black",
          "color": "#000000"
        },
        {
          "slug": "near-black",
          "name": "Near Black",
          "color": "#010101"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#FFFFFF"
        },
        {
          "slug": "dark-card",
          "name": "Dark Card",
          "color": "#212121"
        },
        {
          "slug": "dark-pill",
          "name": "Dark Pill / Schedule Card",
          "color": "#212121"
        },
        {
          "slug": "dark-olive",
          "name": "Dark Olive (CTA Text)",
          "color": "#414726"
        },
        {
          "slug": "grey-muted",
          "name": "Grey Muted Text",
          "color": "#B9B9B9"
        },
        {
          "slug": "grey-body",
          "name": "Grey Body Text",
          "color": "#373737"
        },
        {
          "slug": "red-cross",
          "name": "Red Cross",
          "color": "#EF4343"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "dm-sans",
          "name": "DM Sans",
          "fontFamily": "\"DM Sans\", system-ui, -apple-system, BlinkMacSystemFont, sans-serif"
        },
        {
          "slug": "dm-mono",
          "name": "DM Mono",
          "fontFamily": "\"DM Mono\", ui-monospace, SFMono-Regular, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "Extra Small",
          "size": "0.6875rem"
        },
        {
          "slug": "sm",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "1rem"
        },
        {
          "slug": "lg",
          "name": "Large",
          "size": "1.125rem"
        },
        {
          "slug": "xl",
          "name": "Extra Large",
          "size": "1.25rem"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "1.5rem"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "2rem"
        },
        {
          "slug": "4xl",
          "name": "4XL",
          "size": "2.5rem"
        },
        {
          "slug": "5xl",
          "name": "5XL",
          "size": "3.5rem"
        },
        {
          "slug": "6xl",
          "name": "6XL",
          "size": "4rem"
        }
      ]
    },
    "spacing": {
      "blockGap": true,
      "units": ["px", "rem", "em", "%", "vw"],
      "spacingSizes": [
        { "slug": "xs", "size": "0.5rem", "name": "XS" },
        { "slug": "s", "size": "1rem", "name": "S" },
        { "slug": "m", "size": "1.5rem", "name": "M" },
        { "slug": "l", "size": "3rem", "name": "L" },
        { "slug": "xl", "size": "5rem", "name": "XL" },
        { "slug": "2xl", "size": "7.5rem", "name": "2XL" },
        { "slug": "section", "size": "90px", "name": "Section Gutter" }
      ]
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "0px"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--dm-sans)",
      "lineHeight": "1.5"
    },
    "color": {
      "background": "var(--wp--preset--color--black)",
      "text": "var(--wp--preset--color--white)"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--5xl)",
          "fontWeight": "900",
          "letterSpacing": "-0.02em",
          "lineHeight": "1.05"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--4xl)",
          "fontWeight": "700",
          "letterSpacing": "-0.02em",
          "lineHeight": "1.1"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3xl)",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "p": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--base)",
          "lineHeight": "1.6"
        }
      }
    }
  }
}
